# Copy this file to .env.local and replace both placeholders with your own
# Supabase project values (Project Settings -> API).
#
# Both values are public and safe to expose: the anon key is protected by
# row-level security, not by secrecy (D-055). Never put the service-role key here.
#
# .env.local is gitignored. This file contains placeholders only.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
